# ---------------------------------------------------------------------------
# Ideabro configuration. Copy to .env and fill in. Without keys the app runs
# in demo mode (placeholder clips + template scripts) so you can try the flow.
# ---------------------------------------------------------------------------

# APIMart key: used for Gemini Omni 1.1 Flash video AND (by default) for the script LLM.
APIMART_API_KEY=

# Public URL where this server is reachable (e.g. https://ideabro.example.com or an ngrok URL).
# APIMart must be able to download your uploaded asset images and clips from here.
# Without it, images are sent as base64 data URIs and the previous clip's APIMart URL is
# used as the video reference (works while that URL is still live).
PUBLIC_BASE_URL=

# --- Video generation (APIMart) -------------------------------------------
APIMART_BASE_URL=https://api.apimart.ai
APIMART_VIDEO_MODEL=gemini-omni-1.1-flash
APIMART_RESOLUTION=720p
# Aspect ratios the model accepts; others are generated at the closest one and cropped by FFmpeg.
APIMART_SUPPORTED_ASPECTS=9:16,16:9,1:1
# Max reference images per request.
APIMART_MAX_IMAGE_REFS=5
APIMART_ALLOW_DATA_URI=true
# Extra JSON merged into every generation request, for new/renamed API fields. Example:
# APIMART_EXTRA_BODY={"generate_audio":true}
APIMART_EXTRA_BODY=
APIMART_POLL_INTERVAL_MS=5000
APIMART_TIMEOUT_MS=1200000

# --- Script / idea LLM (any OpenAI-compatible endpoint) ----------------------
# Defaults to APIMart's chat endpoint with the APIMART_API_KEY.
LLM_BASE_URL=https://api.apimart.ai/v1
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_VISION_MODEL=

# --- Clips ------------------------------------------------------------------
MAX_CLIP_SEC=10
MIN_CLIP_SEC=3

# --- Force demo mode even with keys set --------------------------------------
# MOCK_VIDEO=true
# MOCK_LLM=true

# --- Server / FFmpeg ----------------------------------------------------------
PORT=8787
DATA_DIR=data
# Use a specific FFmpeg (otherwise system ffmpeg, then the bundled static build).
FFMPEG_PATH=
FFPROBE_PATH=
# Caption font family and a directory of .ttf files (defaults to bundled DejaVu Sans).
CAPTION_FONT=DejaVu Sans
CAPTION_FONTS_DIR=
