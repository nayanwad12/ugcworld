# ---------------------------------------------------------------------------
# Ideabro configuration. Copy to .env and fill in. Without keys the app runs
# in demo mode (placeholder clips + template scripts) so you can try the flow.
# ---------------------------------------------------------------------------

# APIMart key: used for Gemini Omni 1.1 Flash video AND (by default) for the script LLM.
APIMART_API_KEY=

# Public URL where this server is reachable (e.g. https://ideabro.example.com or an ngrok URL).
# REQUIRED for real generation with uploaded images: APIMart only accepts public HTTP(S) image URLs,
# so it downloads your assets from PUBLIC_BASE_URL/files/... (or use a public URL per asset).
PUBLIC_BASE_URL=

# --- Video generation (APIMart · Gemini Omni 1.1 Flash) --------------------
# Docs: https://docs.apimart.ai/en/api-reference/videos/gemini-omni-1.1-flash/generation
APIMART_BASE_URL=https://api.apimart.ai
APIMART_VIDEO_MODEL=gemini-omni-1.1-flash
# Default for new projects (changeable per project): 360p | 720p | 1080p | 4k
APIMART_RESOLUTION=720p
# Omni only supports 16:9 and 9:16; 1:1 / 4:5 platforms are generated at 9:16 and cropped.
APIMART_SUPPORTED_ASPECTS=9:16,16:9
# Max reference images per request (API limit: 10 incl. first/last frames).
APIMART_MAX_IMAGE_REFS=10
# How clip N continues from clip N-1 (default for new projects, changeable per project):
#   reference = send clip N-1 as video_urls   (needs a public URL for the clip)
#   extend    = send extend_from_task_id      (no URL needed)
APIMART_CONTINUITY=reference
# Send metadata.task explicitly (reference_to_video / extend). Keeps a single reference
# image from being used as the first frame.
APIMART_SEND_TASK_METADATA=true
# Extra JSON merged into every generation request, for new/renamed API fields.
APIMART_EXTRA_BODY=
APIMART_POLL_INTERVAL_MS=5000
APIMART_TIMEOUT_MS=900000

# --- Script / idea LLM (any OpenAI-compatible endpoint) ----------------------
# Defaults to APIMart's chat endpoint with the APIMART_API_KEY.
LLM_BASE_URL=https://api.apimart.ai/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_VISION_MODEL=

# --- Clips ------------------------------------------------------------------
MAX_CLIP_SEC=10
MIN_CLIP_SEC=3

# --- Force demo mode even with keys set --------------------------------------
# MOCK_VIDEO=true
# MOCK_LLM=true

# --- Server / FFmpeg ----------------------------------------------------------
PORT=8787
DATA_DIR=data
# Use a specific FFmpeg (otherwise system ffmpeg, then the bundled static build).
FFMPEG_PATH=
FFPROBE_PATH=
# Caption font family and a directory of .ttf files (defaults to bundled DejaVu Sans).
CAPTION_FONT=DejaVu Sans
CAPTION_FONTS_DIR=
